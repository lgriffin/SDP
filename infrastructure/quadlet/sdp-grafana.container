# Grafana with the SDP run-metrics and GPU dashboard provisioned (NFR-010); loopback only.
# Admin password: printf '%s' "$PASSWORD" | podman secret create sdp_grafana_admin_password -
[Unit]
Description=SDP Grafana
After=sdp-prometheus.service

[Container]
ContainerName=sdp-grafana
Image=docker.io/grafana/grafana-oss:11.3.1
Network=sdp.network
PublishPort=127.0.0.1:3001:3000
User=472
DropCapability=ALL
NoNewPrivileges=true
Secret=sdp_grafana_admin_password,type=mount,target=/run/secrets/grafana_admin_password,uid=472,mode=0400
Environment=GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password GF_USERS_ALLOW_SIGN_UP=false SDP_PROMETHEUS_URL=http://sdp-prometheus:9090
Volume=%h/sdp/infrastructure/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=%h/sdp/infrastructure/grafana/dashboards:/var/lib/grafana/dashboards:ro
Volume=sdp-grafana.volume:/var/lib/grafana

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
