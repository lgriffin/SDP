# Copy this file to .env at the top of your SDP checkout and fill in the values.
# .env is gitignored: never commit it, and never paste its contents into a PR, issue or chat.

# NASA ADS API token, for `sdp publication` (get one at https://ui.adsabs.harvard.edu/user/settings/token)
ADS_API_TOKEN=your-ads-token-here
