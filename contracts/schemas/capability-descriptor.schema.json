{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgriffin/SDP/contracts/schemas/v1/capability-descriptor.schema.json",
  "x-version": "1.0.0",
  "title": "SourceCapabilityDescriptor",
  "description": "What a source can do, read from RegTAP, VOSI and ObsCore where published, or hand-written for a native service (v0.4.0 \u00a72, ADR-017).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "ivoid",
    "title",
    "publisher",
    "origin",
    "verified_on",
    "protocols",
    "data_models",
    "product_types",
    "missions",
    "instruments",
    "coverage",
    "operations",
    "cutout_support",
    "access",
    "limits",
    "rights",
    "adapter"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "ivoid": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "registry",
        "hand-written"
      ]
    },
    "verified_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "standard",
          "version",
          "base_url"
        ],
        "properties": {
          "standard": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "base_url": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data_models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "product_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "image",
          "spectrum",
          "cube",
          "timeseries",
          "measurements",
          "catalogue",
          "preview",
          "thumbnail",
          "auxiliary"
        ]
      },
      "uniqueItems": true
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_sky",
        "regions",
        "t_min_mjd",
        "t_max_mjd",
        "em_min_m",
        "em_max_m"
      ],
      "properties": {
        "all_sky": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shape",
              "ra_deg",
              "dec_deg",
              "radius_deg"
            ],
            "properties": {
              "shape": {
                "const": "cone"
              },
              "ra_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "dec_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "radius_deg": {
                "type": "number",
                "exclusiveMaximum": 10
              }
            }
          }
        },
        "t_min_mjd": {
          "type": [
            "number",
            "null"
          ]
        },
        "t_max_mjd": {
          "type": [
            "number",
            "null"
          ]
        },
        "em_min_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "em_max_m": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cone",
          "region",
          "criteria",
          "product_listing",
          "download",
          "cutout"
        ]
      },
      "uniqueItems": true
    },
    "cutout_support": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "soda",
          "astrocut",
          "per-product",
          "native",
          "none"
        ]
      }
    },
    "access": {
      "type": "string",
      "enum": [
        "public",
        "exclusive_access",
        "login"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rows",
        "page_size",
        "requests_per_second",
        "max_concurrent",
        "upload",
        "throughput_bytes_per_s"
      ],
      "properties": {
        "max_rows": {
          "type": [
            "integer",
            "null"
          ]
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "requests_per_second": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_concurrent": {
          "type": [
            "integer",
            "null"
          ]
        },
        "upload": {
          "type": "boolean"
        },
        "throughput_bytes_per_s": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "licence",
        "citation",
        "acknowledgement"
      ],
      "properties": {
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "acknowledgement": {
          "type": "string"
        }
      }
    },
    "adapter": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "last_compatibility_check",
            "conformance"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "$ref": "common.schema.json#/$defs/SchemaVersion"
            },
            "last_compatibility_check": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "conformance": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
