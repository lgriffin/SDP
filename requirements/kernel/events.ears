# requirements/kernel/events.ears
capability: Domain events
owner: kernel
requirements:
  - id: KRN-010
    pattern: ubiquitous
    text: "The kernel shall append every domain event to the event log in the same transaction as the state change it describes."
    rationale: "The harness and UI consume events; a state change without its event is invisible."
    verification: test
    tiers: [T5]
    status: approved
    traces:
      - "python/tests.contract.test_kernel_fakes.TestUnitOfWork::test_evidence_graph_answers_lineage"
      - "python/tests.contract.test_kernel_fakes.TestUnitOfWork::test_exception_inside_unit_of_work_rolls_back"
      - "python/tests.contract.test_kernel_fakes.TestUnitOfWork::test_rollback_discards_state_and_events_together"
      - "python/tests.contract.test_kernel_fakes.TestUnitOfWork::test_state_and_events_commit_together"
