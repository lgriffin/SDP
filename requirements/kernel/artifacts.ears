# requirements/kernel/artifacts.ears
capability: Artifact immutability
owner: kernel
requirements:
  - id: KRN-014
    pattern: ubiquitous
    text: "The kernel shall prevent modification of raw artifacts through application workflows."
    rationale: "Raw data are never modified in place (ADR-008)."
    verification: test
    tiers: [T3]
    status: approved
    traces:
      - "python/tests.contract.test_kernel_fakes.TestArtifactStore::test_raw_paths_are_write_once"
      - "python/tests.contract.test_kernel_fakes.TestDatasetRepository::test_registered_raw_metadata_cannot_be_rewritten"
      - "python/tests.usecase.test_acquire_dataset::test_raw_artifacts_cannot_be_replaced_through_workflows"
