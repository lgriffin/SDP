# requirements/contracts/boundary.ears
capability: Polyglot contract boundary
owner: contracts
requirements:
  - id: CTR-001
    pattern: ubiquitous
    text: "Every boundary type shall be defined once under contracts/schemas and generated into both languages."
    rationale: "Neither language hand-writes a boundary type (ADR-003)."
    verification: test
    tiers: [T6]
    status: approved
    traces:
      - "python/tests.contracts.test_contracts_python::test_packaged_schemas_are_the_source_schemas"
      - "typescript/packages/contracts/test/contracts.test.ts::[CTR-001] has a generated schema for every contract"
  - id: CTR-002
    pattern: unwanted
    text: "If committed generated code differs from a fresh generation, then CI shall fail."
    rationale: "A schema edit without regeneration must not merge."
    verification: test
    tiers: [T6]
    status: approved
    traces:
      - "python/tests.contracts.test_contracts_python::test_committed_pydantic_models_match_a_fresh_generation"
      - "typescript/packages/contracts/test/contracts.test.ts::[CTR-002] matches a fresh generation byte for byte"
  - id: CTR-003
    pattern: ubiquitous
    text: "Both languages shall accept every fixture under fixtures/valid and reject every fixture under fixtures/invalid at the expected error path."
    rationale: "Golden fixtures pin agreement between the two toolchains."
    verification: test
    tiers: [T6]
    status: approved
    traces:
      - "python/tests.contracts.test_contracts_python::test_invalid_fixtures_are_rejected_at_the_expected_path"
      - "python/tests.contracts.test_contracts_python::test_valid_fixtures_are_accepted"
      - "python/tests.unit.kernel.test_canonical::test_canonical_vectors_reproduce_byte_for_byte"
      - "typescript/packages/contracts/test/contracts.test.ts::[CTR-003] rejects invalid fixtures at the expected path"
  - id: CTR-004
    pattern: ubiquitous
    text: "An evidence manifest shall carry schema_version, and the harness shall read the current and the previous major version."
    rationale: "Manifests outlive releases; the harness reads one major back."
    verification: test
    tiers: [T6]
    status: approved
    traces:
      - "typescript/packages/contracts/test/contracts.test.ts::[CTR-004] reads the major version of every manifest fixture"
      - "typescript/packages/spec-harness/test/conform.test.ts::[CTR-004] reads every valid manifest fixture, 1.0 and 1.1"
      - "typescript/packages/spec-harness/test/conform.test.ts::[CTR-004] refuses a major it does not support, naming the path"
  - id: CTR-005
    pattern: event
    text: "When the GraphQL schema changes, the committed schema.graphql and the generated client shall change in the same commit."
    rationale: "The UI client and the API must not drift."
    verification: test
    tiers: [T6]
    status: draft
    traces: []
  - id: CTR-006
    pattern: ubiquitous
    text: "Every domain-to-DTO mapper shall round-trip its type."
    rationale: "Mappers are the only bridge between domain and DTO types."
    verification: test
    tiers: [T2]
    status: approved
    traces:
      - "python/tests.contracts.test_mappers::test_dataset_artifacts_round_trip"
      - "python/tests.contracts.test_mappers::test_ledger_entry_round_trips"
      - "python/tests.contracts.test_mappers::test_predeclaration_round_trips"
