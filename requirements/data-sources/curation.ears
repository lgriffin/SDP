# requirements/data-sources/curation.ears
capability: Curation and storage
owner: data-sources
requirements:
  - id: DSI-005
    pattern: ubiquitous
    text: "Curated datasets shall carry dialect id, dialect version and the raw parent artifact id."
    rationale: "Curated data must cite the raw bytes and mapping they came from."
    verification: test
    tiers: [T3]
    status: draft
    traces: []
  - id: DSI-006
    pattern: unwanted
    text: "If a source descriptor declares no licence, then the system shall block curation of that source."
    rationale: "Data without a licence cannot be redistributed in a bundle."
    verification: test
    tiers: [T4]
    status: draft
    traces: []
  - id: DSI-010
    pattern: state
    text: "While NAS free space is below the configured threshold, the system shall refuse new acquisitions."
    rationale: "NAS exhaustion fails workflows; refuse early instead."
    verification: test
    tiers: [T5]
    status: draft
    traces: []
