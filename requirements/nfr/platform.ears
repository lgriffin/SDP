# requirements/nfr/platform.ears
capability: Platform and operations
owner: platform
requirements:
  - id: NFR-001
    pattern: ubiquitous
    text: "The platform shall run on the designated DGX Spark under rootless Podman."
    rationale: "The DGX Spark is the only compute host (§2)."
    verification: demonstration
    tiers: []
    status: draft
    traces: []
  - id: NFR-002
    pattern: ubiquitous
    text: "The platform shall pass every scientific tier on CPU-only execution."
    rationale: "GPU results are never required for a gate (ADR-007)."
    verification: test
    tiers: [T8]
    status: approved
    traces:
      - "python/tests.relativity.test_protocol::test_a_clean_synthetic_run_is_inconclusive_only_for_want_of_verified_oracles"
      - "python/tests.stellar.test_protocol::test_a_clean_synthetic_run_passes_every_gate"
  - id: NFR-003
    pattern: ubiquitous
    text: "The platform shall verify artifact SHA-256 on every read from the artifact store."
    rationale: "Input integrity (§15)."
    verification: test
    tiers: [T3, T5]
    status: approved
    traces:
      - "python/tests.contract.test_kernel_fakes.TestArtifactStore::test_get_returns_exactly_what_was_put"
      - "python/tests.contract.test_kernel_fakes.TestArtifactStore::test_put_returns_the_sha256_of_the_bytes"
      - "python/tests.usecase.test_acquire_dataset::test_reads_verify_sha256"
  - id: NFR-004
    pattern: ubiquitous
    text: "The platform shall reproduce every released experiment from pinned environments and accessible inputs in a fresh container."
    rationale: "Reproducibility level 1 for every release."
    verification: test
    tiers: [T9]
    status: approved
    traces:
      - "python/tests.reproduction.test_reproduce::test_a_synthetic_experiment_reproduces_from_its_manifest_and_inputs"
      - "python/tests.reproduction.test_reproduce::test_uc01_with_seeded_nulls_and_injections_reproduces_through_the_cli"
      - "python/tests.reproduction.test_reproduce::test_a_changed_finding_or_verdict_is_named"
  - id: NFR-005
    pattern: ubiquitous
    text: "The kernel shall write structured logs that carry experiment id, task id, duration, resource usage and failure reason."
    rationale: "Unattended runs must report plainly."
    verification: test
    tiers: [T5]
    status: approved
    traces:
      - "python/tests.usecase.test_run_experiment::test_logs_carry_experiment_task_duration_resources_and_failure"
  - id: NFR-006
    pattern: ubiquitous
    text: "The kernel shall keep domain and science code free of dependencies on infrastructure implementations."
    rationale: "Hexagonal dependency rule (§4)."
    verification: test
    tiers: [T0]
    status: approved
    traces:
      - "python/tests.architecture.test_architecture::test_domain_and_science_ports_do_not_depend_on_infrastructure"
      - "python/tests.architecture.test_architecture::test_domain_is_pure"
      - "python/tests.architecture.test_architecture::test_import_linter_contracts_are_kept"
  - id: NFR-007
    pattern: ubiquitous
    text: "The persistence layer shall version every schema migration and test it one step forward and one step back."
    rationale: "Metadata outlives code versions."
    verification: test
    tiers: [T5]
    status: approved
    traces:
      - "python/tests.integration.test_migrations::test_downgrade_to_zero_leaves_only_the_version_table"
      - "python/tests.integration.test_migrations::test_every_migration_steps_forward_and_back"
      - "python/tests.integration.test_migrations::test_upgrade_is_idempotent_and_records_versions"
  - id: NFR-008
    pattern: ubiquitous
    text: "The kernel shall document, per TaskKind, any nondeterminism that prevents bitwise reproduction."
    rationale: "Nondeterminism is documented, not hidden."
    verification: inspection
    tiers: [T0]
    status: approved
    traces:
      - "python/tests.architecture.test_determinism_doc::test_every_registered_task_kind_has_a_note_and_is_in_the_determinism_doc"
      - "python/tests.stellar.test_protocol.TestStellarClusterProtocol::test_nondeterminism_is_documented_for_every_non_bitwise_task_kind"
      - "python/tests.relativity.test_protocol.TestEinstein1919Protocol::test_nondeterminism_is_documented_for_every_non_bitwise_task_kind"
  - id: NFR-009
    pattern: ubiquitous
    text: "The platform shall keep credentials outside Git, run containers as a non-root user, and validate downloads before parsing."
    rationale: "Least privilege and untrusted-data handling (§15)."
    verification: test
    tiers: [T0, T5]
    status: approved
    traces:
      - "python/tests.architecture.test_deployment::test_the_compose_stack_runs_unprivileged_and_takes_credentials_from_secret_files"
      - "python/tests.architecture.test_deployment::test_api_and_runner_read_their_credentials_from_mounted_secrets"
      - "python/tests.publication.test_zenodo::test_credentials_can_come_from_a_mounted_secret_file"
      - "python/tests.publication.test_zenodo::test_the_database_url_can_come_from_a_secret_file_and_stays_out_of_reprs"
      - "python/tests.archives.test_untrusted::test_the_gateway_refuses_a_hostile_response_and_parses_others_in_isolation"
      - "python/tests.archives.test_untrusted::test_the_child_runs_under_the_configured_address_space_limit"
  - id: NFR-010
    pattern: ubiquitous
    text: "The platform shall export run metrics and GPU telemetry for Grafana."
    rationale: "Operability of multi-hour runs (§2)."
    verification: test
    tiers: [T5]
    status: approved
    traces:
      - "python/tests.integration.test_adapters_specific::test_gpu_telemetry_parses_nvidia_smi_and_is_empty_without_a_gpu"
      - "python/tests.integration.test_adapters_specific::test_tracker_writes_prometheus_gauges_per_experiment"
