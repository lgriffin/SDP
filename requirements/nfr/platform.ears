# requirements/nfr/platform.ears
capability: Platform and operations
owner: platform
requirements:
  - id: NFR-001
    pattern: ubiquitous
    text: "The platform shall run on the designated DGX Spark under rootless Podman."
    rationale: "The DGX Spark is the only compute host (§2)."
    verification: demonstration
    tiers: []
    status: draft
    traces: []
  - id: NFR-002
    pattern: ubiquitous
    text: "Every scientific tier shall pass on CPU-only execution."
    rationale: "GPU results are never required for a gate (ADR-007)."
    verification: test
    tiers: [T8]
    status: draft
    traces: []
  - id: NFR-003
    pattern: ubiquitous
    text: "The platform shall verify artifact SHA-256 on every read from the artifact store."
    rationale: "Input integrity (§15)."
    verification: test
    tiers: [T3, T5]
    status: approved
    traces:
      - "python/tests.contract.test_kernel_fakes.TestArtifactStore::test_get_returns_exactly_what_was_put"
      - "python/tests.contract.test_kernel_fakes.TestArtifactStore::test_put_returns_the_sha256_of_the_bytes"
      - "python/tests.usecase.test_acquire_dataset::test_reads_verify_sha256"
  - id: NFR-004
    pattern: ubiquitous
    text: "Released experiments shall reproduce from pinned environments and accessible inputs in a fresh container."
    rationale: "Reproducibility level 1 for every release."
    verification: test
    tiers: [T9]
    status: draft
    traces: []
  - id: NFR-005
    pattern: ubiquitous
    text: "Logs shall be structured and carry experiment id, task id, duration, resource usage and failure reason."
    rationale: "Unattended runs must report plainly."
    verification: test
    tiers: [T5]
    status: approved
    traces:
      - "python/tests.usecase.test_run_experiment::test_logs_carry_experiment_task_duration_resources_and_failure"
  - id: NFR-006
    pattern: ubiquitous
    text: "Domain and science code shall not depend on infrastructure implementations."
    rationale: "Hexagonal dependency rule (§4)."
    verification: test
    tiers: [T0]
    status: approved
    traces:
      - "python/tests.architecture.test_architecture::test_domain_and_science_ports_do_not_depend_on_infrastructure"
      - "python/tests.architecture.test_architecture::test_domain_is_pure"
      - "python/tests.architecture.test_architecture::test_import_linter_contracts_are_kept"
  - id: NFR-007
    pattern: ubiquitous
    text: "Schema migrations shall be versioned and tested one step forward and one step back."
    rationale: "Metadata outlives code versions."
    verification: test
    tiers: [T5]
    status: approved
    traces:
      - "python/tests.integration.test_migrations::test_downgrade_to_zero_leaves_only_the_version_table"
      - "python/tests.integration.test_migrations::test_every_migration_steps_forward_and_back"
      - "python/tests.integration.test_migrations::test_upgrade_is_idempotent_and_records_versions"
  - id: NFR-008
    pattern: ubiquitous
    text: "Nondeterminism that prevents bitwise reproduction shall be documented per TaskKind."
    rationale: "Nondeterminism is documented, not hidden."
    verification: inspection
    tiers: []
    status: draft
    traces: []
  - id: NFR-009
    pattern: ubiquitous
    text: "Credentials shall live outside Git, containers shall not run as root, and downloads shall be validated before parsing."
    rationale: "Least privilege and untrusted-data handling (§15)."
    verification: test
    tiers: [T5]
    status: draft
    traces: []
  - id: NFR-010
    pattern: ubiquitous
    text: "Run metrics and GPU telemetry shall be exported for Grafana."
    rationale: "Operability of multi-hour runs (§2)."
    verification: test
    tiers: [T5]
    status: approved
    traces:
      - "python/tests.integration.test_adapters_specific::test_gpu_telemetry_parses_nvidia_smi_and_is_empty_without_a_gpu"
      - "python/tests.integration.test_adapters_specific::test_tracker_writes_prometheus_gauges_per_experiment"
