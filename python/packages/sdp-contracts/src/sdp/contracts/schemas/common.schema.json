{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgriffin/SDP/contracts/schemas/v1/common.schema.json",
  "x-version": "1.0.0",
  "title": "Common",
  "description": "Shared definitions referenced by every SDP contract schema.",
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "Sha256Id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Quantity": {
      "type": "object",
      "description": "A physical value as it crosses the boundary: value plus astropy unit string.",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "NumericalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dtype",
        "rtol",
        "atol",
        "determinism",
        "seed_handling"
      ],
      "properties": {
        "dtype": {
          "type": "string",
          "enum": [
            "float32",
            "float64",
            "int64",
            "bool",
            "object"
          ]
        },
        "rtol": {
          "type": "number",
          "minimum": 0
        },
        "atol": {
          "type": "number",
          "minimum": 0
        },
        "determinism": {
          "type": "string",
          "enum": [
            "bitwise",
            "tolerance",
            "statistical"
          ]
        },
        "seed_handling": {
          "type": "string",
          "enum": [
            "none",
            "explicit",
            "derived"
          ]
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "description": "Identity of an archive release, a document, a local store or a synthetic generator. Archives must name a release; documents must name a DOI or a bibliographic reference.",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity",
        "licence",
        "citation"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "archive",
            "document",
            "local",
            "synthetic"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "release_label": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$"
        },
        "query_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "bibcode": {
          "type": [
            "string",
            "null"
          ]
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "archive"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "release_label"
            ],
            "properties": {
              "release_label": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "document"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "doi"
                ],
                "properties": {
                  "doi": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "bibcode"
                ],
                "properties": {
                  "bibcode": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "Comparator": {
      "type": "string",
      "enum": [
        "lt",
        "le",
        "gt",
        "ge",
        "eq",
        "ne"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "blocking",
        "warning"
      ]
    },
    "GateId": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-G-[0-9]{2}$"
    },
    "Gate": {
      "type": "object",
      "description": "A predeclared check: finding <comparator> threshold.",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "description",
        "finding",
        "comparator",
        "threshold",
        "severity",
        "oracle_ids"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/GateId"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "comparator": {
          "$ref": "#/$defs/Comparator"
        },
        "threshold": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "oracle_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "CheckOutcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "missing",
        "oracle_unverified"
      ]
    },
    "Check": {
      "type": "object",
      "description": "A gate evaluated against a finding value.",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "finding",
        "value",
        "comparator",
        "threshold",
        "severity",
        "oracle_ids",
        "oracles_verified",
        "outcome"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/GateId"
        },
        "finding": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparator": {
          "$ref": "#/$defs/Comparator"
        },
        "threshold": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "oracle_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "oracles_verified": {
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        }
      }
    },
    "VerdictStatus": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "CANDIDATE",
        "REJECTED",
        "INCONCLUSIVE"
      ]
    },
    "Verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "protocol_version",
        "reasons"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/VerdictStatus"
        },
        "protocol_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
